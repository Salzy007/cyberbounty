ADMIN_PASSWORD=придумайте-пароль-владельца
# PORT=8002

# --- Вход через Telegram: достаточно username бота (без @) и запущенного бота на той же базе. Токен и домен не нужны.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Вход через Google. Client ID из Google Cloud (OAuth, тип «Web»); в «Authorized JavaScript origins» — адрес сайта.
GOOGLE_CLIENT_ID=

# --- Вход по почте (код из 6 цифр). Не заполнено — код печатается в окне сервера (режим разработки).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CyberBounty <noreply@example.com>

# --- Если настоящий вход идёт по https (туннель, домен) — включите защищённые cookie
# SECURE_COOKIE=1

# --- Общая база с ботом: у бота в .env пропишите DB_PATH=<эта папка>\data\pcclub.db (по умолчанию data\pcclub.db)
# DB_PATH=
